<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.collections.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="600" prefWidth="800" styleClass="background" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.game.gui.GameSetupController">

    <top>
        <Text styleClass="mainTitle" text="Light Bulbs" BorderPane.alignment="CENTER"  textAlignment="CENTER" />
    </top>

    <center>
        <VBox alignment="CENTER" spacing="20">
            <Label styleClass="subtitle" text="New Game" alignment="CENTER" textAlignment="CENTER" />

            <GridPane alignment="CENTER" hgap="10" vgap="15">

                <Label text="Difficulty:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <ComboBox fx:id="difficultyComboBox" onAction="#onDifficultyChange" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Easy" />
                            <String fx:value="Medium" />
                            <String fx:value="Hard" />
                            <String fx:value="Custom" />
                        </FXCollections>
                    </items>
                </ComboBox>

                <Label text="Size:" GridPane.columnIndex="0" GridPane.rowIndex="1" alignment="CENTER" textAlignment="CENTER" />
                <Spinner fx:id="sizeSpinner" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Empty cells:" GridPane.columnIndex="0" GridPane.rowIndex="2" alignment="CENTER" textAlignment="CENTER" />
                <Slider fx:id="emptySlider" showTickLabels="true" showTickMarks="true" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Shuffle strength:" GridPane.columnIndex="0" GridPane.rowIndex="3" alignment="CENTER" textAlignment="CENTER" />
                <Slider fx:id="shuffleSlider" showTickLabels="true" showTickMarks="true" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label text="Max time (mins):" GridPane.columnIndex="0" GridPane.rowIndex="4" alignment="CENTER" textAlignment="CENTER" />
                <Spinner fx:id="timeSpinner" GridPane.columnIndex="1" GridPane.rowIndex="4" />

            </GridPane>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="30">
            <Button onAction="#onBackClicked" text="Back to Main Menu" />
            <Button onAction="#onPlayClicked" text="Start the Game" />
        </HBox>
    </bottom>

</BorderPane>
