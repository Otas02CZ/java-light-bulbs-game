<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.game.gui.GameSetupController"
            prefWidth="800" prefHeight="600"
            stylesheets="@styles-game-setup.css"
            styleClass="game-setup-root">

    <top>
        <VBox alignment="CENTER" spacing="10">
            <Label text="Light Bulbs" styleClass="title-label"/>
        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="20">
            <Label text="New Game" styleClass="subtitle-label"/>

            <GridPane hgap="10" vgap="15" alignment="CENTER">

                <Label text="Difficulty:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="difficultyComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Easy"/>
                            <String fx:value="Medium"/>
                            <String fx:value="Hard"/>
                            <String fx:value="Custom"/>
                        </FXCollections>
                    </items>
                </ComboBox>

                <Label text="Size:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Spinner fx:id="sizeSpinner" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Empty cells:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <Spinner fx:id="emptyCellsSpinner" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Shuffle coefficient:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <Spinner fx:id="shuffleSpinner" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Time (mins):" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <Spinner fx:id="timeSpinner" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

            </GridPane>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="30">
            <Button text="Cancel" onAction="#onCancelClicked" />
            <Button text="Play" onAction="#onPlayClicked" />
        </HBox>
    </bottom>

</BorderPane>
