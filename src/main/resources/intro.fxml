<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane
        styleClass="background"
        prefHeight="600"
        prefWidth="800"
        stylesheets="@styles-intro.css"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.example.game.gui.IntroController">

   <!-- Title at the top -->
   <top>
      <Text styleClass="mainTitle" text="Light Bulbs" BorderPane.alignment="CENTER" />
   </top>

   <!-- Center area with buttons -->
   <center>
      <VBox alignment="CENTER" spacing="20">
         <Button styleClass="button-text" onAction="#handleNewGame" text="New Game" textAlignment="CENTER" />
         <Button styleClass="button-text" onAction="#handleLoadGame" text="Load Game" />
         <Button styleClass="button-text" onAction="#handleHowToPlay" text="How to Play?" />
         <Button styleClass="button-text" onAction="#handleCredits" text="Credits" />
         <Button styleClass="button-text" onAction="#handleQuit" text="Quit" />
      </VBox>
   </center>

   <!-- Bottom section -->
   <bottom>
      <HBox spacing="10" BorderPane.alignment="BOTTOM_CENTER">
         <!-- Authors section on the left -->
         <VBox alignment="BOTTOM_LEFT">
            <Label styleClass="authorLabel" text="Otakar Kočí" />
            <Label styleClass="authorLabel" text="Martin Mendl\uD83D\uDFE9" />
         </VBox>

         <!-- This Region acts as a spacer to push the year label to the far right -->
         <Region HBox.hgrow="ALWAYS" />

         <!-- Year label directly at the bottom-right -->
         <VBox alignment="BOTTOM_LEFT">
            <Label styleClass="yearLabel" text="2025" />
         </VBox>

      </HBox>
   </bottom>

</BorderPane>
