<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.example.game.gui.IntroController"
        styleClass="background"
        stylesheets="@styles.css"
>

   <!-- Title at the top -->
   <top>
      <Label styleClass="mainTitle" text="Light Bulbs" BorderPane.alignment="CENTER" textAlignment="CENTER" />
   </top>

   <!-- Center area with buttons -->
   <center>
      <VBox alignment="CENTER" spacing="20">
         <Button styleClass="button-text" onAction="#handleNewGame" text="New Game" textAlignment="CENTER" />
         <Button styleClass="button-text" onAction="#handleLoadGame" text="Load Game" />
         <Button styleClass="button-text" onAction="#handleHowToPlay" text="How to Play" />
         <Button styleClass="button-text" onAction="#handleCredits" text="Credits" />
         <Button styleClass="button-text" onAction="#handleQuit" text="Quit" />
      </VBox>
   </center>

   <!-- Bottom section -->
   <bottom>
      <BorderPane>
         <!-- Total turns label -->
         <left>
            <VBox>
               <Label styleClass="infoLabel" text="Otakar Kočí" alignment="CENTER" textAlignment="CENTER" />
               <Label styleClass="infoLabel" text="Martin Mendl" alignment="CENTER" textAlignment="CENTER" />
            </VBox>
         </left>
         <!-- Difficulty -->
         <center>
            <VBox>
               <Button fx:id="musicButton" styleClass="button-text" onAction="#handleMusicControls" text="Music: OFF" />
            </VBox>
         </center>
         <!-- Lit up bulbs label -->
         <right>
            <VBox>
               <Label styleClass="infoLabel" text="2025" alignment="CENTER" textAlignment="CENTER" />
            </VBox>
         </right>
      </BorderPane>
   </bottom>

</BorderPane>
