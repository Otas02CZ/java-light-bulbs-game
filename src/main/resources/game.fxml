<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="gamePane" prefHeight="600" prefWidth="900" styleClass="background" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.game.gui.GameController">

    <!-- Top Area -->
    <top>
        <VBox spacing="5">
            <ToolBar prefHeight="40.0" prefWidth="200.0">
                <Button mnemonicParsing="false" onAction="#handleToMainMenu" text="Main Menu" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#handleQuit" text="Quit" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#handleShowHowToPlay" text="How To Play" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                <Button fx:id="helpViewButton" mnemonicParsing="false" onAction="#handleShowHelpView" text="Help View" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                <Button fx:id="solveButton" mnemonicParsing="false" onAction="#handleSolve" text="Auto Solving" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                <Button fx:id="saveButton" mnemonicParsing="false" onAction="#handleSave" text="Save" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                <Button fx:id="undoButton" mnemonicParsing="false" onAction="#handleUndo" text="Undo" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                <Button fx:id="redoButton" mnemonicParsing="false" onAction="#handleRedo" text="Redo" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
            </ToolBar>

            <!-- Large Centered Text Label -->
            <Label styleClass="subtitle" fx:id="mainLabel" text="Hurry up! Time is Ticking!" alignment="CENTER" textAlignment="CENTER" maxWidth="Infinity" >
                <VBox.margin>
                    <Insets top="5" />
                </VBox.margin>
            </Label>

            <!-- Timer Row -->
            <HBox alignment="CENTER" spacing="10">
                <ImageView fx:id="timerIcon" fitHeight="24" fitWidth="24" />
                <Label  styleClass="infoLabel"  fx:id="timerLabel" text="00:00" alignment="CENTER" textAlignment="CENTER" />
            </HBox>

        </VBox>
    </top>

    <!-- Center Area -->
    <center>
        <VBox alignment="CENTER" fillWidth="false">
            <GridPane fx:id="gameGrid">
                <!-- game cells -->
            </GridPane>
        </VBox>
    </center>

    <!-- Bottom Area -->
    <bottom>
        <BorderPane>
            <left>
                <Label styleClass="infoLabel" fx:id="turnsLabel" text="Turns: 0" alignment="CENTER" textAlignment="CENTER" />
            </left>
            <center>
                <Label styleClass="infoLabel" fx:id="difficultyLabel" text="Hard" alignment="CENTER" textAlignment="CENTER" />
            </center>
            <right>
                <Label styleClass="infoLabel" fx:id="litUpLabel" text="Lit up: 0/0" alignment="CENTER" textAlignment="CENTER" />
            </right>
        </BorderPane>
    </bottom>

</BorderPane>
