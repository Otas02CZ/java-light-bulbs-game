<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="600" prefWidth="800" styleClass="background" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.game.gui.GameController">

    <!-- Top Area -->
    <top>
        <VBox spacing="20">
            <ToolBar prefHeight="40.0" prefWidth="200.0">
                <Button onAction="#handleToMainMenu" mnemonicParsing="false" text="Main Menu" />
                <Button onAction="#handleQuit" mnemonicParsing="false" text="Quit" />
                <Button onAction="#handleShowHowToPlay" mnemonicParsing="false" text="How To Play" />
                <Button onAction="#handleShowHelpView" mnemonicParsing="false" text="Help View" />
                <Button onAction="#handleSolve" mnemonicParsing="false" text="Solve" />
                <Button onAction="#handleSave" mnemonicParsing="false" text="Save" />
            </ToolBar>

            <!-- Large Centered Text Label -->
            <Label fx:id="mainLabel" alignment="CENTER" maxWidth="Infinity" styleClass="main-text" text="Go Go Go !!">
                <VBox.margin>
                    <Insets bottom="10" top="10" />
                </VBox.margin>
            </Label>

            <!-- Timer Row -->
            <HBox alignment="CENTER" spacing="10">
                <ImageView fx:id="timerIcon" fitHeight="24" fitWidth="24" />
                <Label fx:id="timerLabel" text="00:00" />
            </HBox>

        </VBox>
    </top>

    <!-- Center Area -->
    <center>
        <StackPane alignment="CENTER">
            <GridPane fx:id="gameGrid" hgap="5" vgap="5">
                <!-- Game cells will be created programmatically -->
            </GridPane>
        </StackPane>
    </center>

    <!-- Bottom Area -->
    <bottom>
        <BorderPane>
            <left>
                <Label fx:id="turnsLabel" text="Turns: 0" />
            </left>
            <center>
                <Label fx:id="difficultyLabel" text="Hard" />
            </center>
            <right>
                <Label fx:id="litUpLabel" text="Lit up: 0/0" />
            </right>
        </BorderPane>
    </bottom>

</BorderPane>
